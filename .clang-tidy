Checks: >
  llvm-header-guard,
  # modernize-*,
  readability-identifier-naming,
  readability-use-std-min-max,
  readability-use-anyofallof,
  readability-uniqueptr-delete-release,
  readability-string-compare,
  readability-static-definition-in-anonymous-namespace,
  readability-static-accessed-through-instance,
  readability-simplify-subscript-expr,
  readability-simplify-boolean-expr,
  readability-redundant-string-init,
  readability-redundant-smartptr-get,
  readability-redundant-parentheses,
  readability-redundant-member-init,
  readability-redundant-inline-specifier,
  readability-redundant-function-ptr-dereference,
  readability-redundant-declaration,
  readability-redundant-control-flow,
  readability-redundant-casting,
  readability-redundant-access-specifiers,
  readability-operators-representation,
  readability-named-parameter,
  readability-misplaced-array-index,
  readability-math-missing-parentheses,
  readability-make-member-function-const,
  # readability-magic-numbers,
  readability-isolate-declaration,
  readability-inconsistent-declaration-parameter-name,
  readability-function-size,
  readability-function-cognitive-complexity,
  readability-else-after-return,
  readability-duplicate-include,
  # readability-convert-member-functions-to-static,
  readability-container-size-empty,
  readability-container-contains,
  readability-braces-around-statements,
  readability-avoid-return-with-void-value,
  readability-avoid-nested-conditional-operator,
  readability-avoid-const-params-in-decls

HeaderFilterRegex: '(^|.*/)kernel/.*\.hpp$'

CheckOptions:
  - key: readability-uniqueptr-delete-release.PreferResetCall
    value: true
  - key: llvm-header-guard.HeaderFileExtensions
    value: 'h,hpp,hh'
  - key: llvm-header-guard.HeaderGuardPrefix
    value: '__'
  - key: llvm-header-guard.HeaderGuardSuffix
    value: '__'
  - key: readability-identifier-naming.AggressiveDependentMemberLookup
    value: true
  - key: readability-identifier-naming.CheckAnonFieldInParent
    value: false
  - key: readability-identifier-naming.GetConfigPerFile
    value: true
  - key: readability-identifier-naming.IgnoreMainLikeFunctions
    value: true
  - key: readability-identifier-naming.AbstractClassPrefix
    value: 'I'
  - key: readability-identifier-naming.ClassCase
    value: CamelCase
  - key: readability-identifier-naming.ConceptCase
    value: CamelCase
  - key: readability-identifier-naming.EnumCase
    value: CamelCase
  - key: readability-identifier-naming.EnumPrefix
    value: 'E'
  - key: readability-identifier-naming.FunctionCase
    value: lower_case
  - key: readability-identifier-naming.GlobalVariablePrefix
    value: 'g_'
  - key: readability-identifier-naming.MacroDefinitionCase
    value: UPPER_CASE
  - key: readability-identifier-naming.MemberCase
    value: lower_case
  - key: readability-identifier-naming.MethodCase
    value: lower_case
  - key: readability-identifier-naming.NamespaceCase
    value: lower_case
  - key: readability-identifier-naming.ParameterCase
    value: lower_case
  - key: readability-identifier-naming.PrivateMemberPrefix
    value: '_'
  - key: readability-identifier-naming.PrivateMethodPrefix
    value: '_'
  - key: readability-identifier-naming.ProtectedMemberPrefix
    value: '_'
  - key: readability-identifier-naming.ProtectedMethodPrefix
    value: '_'
  - key: readability-identifier-naming.StaticVariableCase
    value: ''
  - key: readability-identifier-naming.StructCase
    value: CamelCase
  - key: readability-identifier-naming.TemplateParameterCase
    value: CamelCase
  - key: readability-identifier-naming.TypeTemplateParameterCase
    value: CamelCase
  - key: readability-identifier-naming.VariableCase
    value: lower_case
